{
  "name": "VibeZ",
  "version": "1.1.2",
  "description": "A graphical client for Mistral Vibe",
  "license": "MIT",
  "homepage": "https://github.com/harald666/vibez",
  "author": {
    "name": "Joe Pizza",
    "email": "info@lecomputeur.nl"
  },
  "main": "main.js",
  "scripts": {
    "start": "ELECTRON_DISABLE_GPU=1 LIBVA_DRIVER_NAME=i965 electron . --disable-gpu --disable-software-rasterizer --no-sandbox",
    "build": "electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.vibez.app",
    "productName": "VibeZ",
    "icon": "build/icons",
    "publish": {
      "provider": "github",
      "owner": "harald666",
      "repo": "vibez",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "category": "Development"
    },
    "pacman": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libxss",
        "libxtst",
        "xdg-utils",
        "at-spi2-core",
        "libsecret"
      ]
    }
  }
}
